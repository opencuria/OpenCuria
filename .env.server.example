# Distributed/server deployment defaults. OAuth requires the frontend and API
# to be same-origin on the public hostname. The bundled Caddy proxy routes /api
# and /ws to the backend and all other paths to the frontend.
# install.sh writes this file for you; for a manual setup:
#   cp .env.server.example .env
#   docker compose -f compose.server.yml up -d

OPENCURIA_TAG=latest

# Bundled reverse proxy on ports 80/443. Remove to use your own reverse proxy.
COMPOSE_PROFILES=proxy
# Public domain; Caddy obtains a Let's Encrypt certificate for it. Leave empty to
# serve plain HTTP on port 80.
OPENCURIA_DOMAIN=app.example.com

# Host port mappings ([address:]port). Behind the bundled proxy they stay on
# loopback; publish them (e.g. 8080 and 8000) for an external reverse proxy.
WEBAPP_PORT=127.0.0.1:8080
BACKEND_PORT=127.0.0.1:8000

WEBAPP_PUBLIC_URL=https://app.example.com
BACKEND_PUBLIC_URL=https://app.example.com
# OAuth frontend and backend must share one public HTTPS hostname/scheme for its SameSite cookie.
MCP_OAUTH_CALLBACK_URL=https://app.example.com/api/v1/mcp-oauth/callback/
MCP_OAUTH_FRONTEND_RETURN_URL=https://app.example.com/?settings=credentials

# Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME_use_a_long_random_string_here

DB_NAME=opencuria
DB_USER=opencuria
DB_PASSWORD=CHANGE_ME_use_a_strong_password_here

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key

DJANGO_SUPERUSER_EMAIL=admin@localhost.test
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_admin_password

# Defaults are suitable for direct port exposure.
DJANGO_ALLOWED_HOSTS=app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
SIO_CORS_ALLOWED_ORIGINS=https://app.example.com

# Optional server-wide native push; keys are read from files at backend startup.
# Leave all APNs values empty to disable iOS; leave the FCM path empty for Android.
APNS_TEAM_ID=
APNS_KEY_ID=
# Compose mounts ./secrets/push/ read-only at /run/secrets/ in the backend.
# Put apns.p8 and/or firebase.json there, then set the corresponding container path:
# APNS_PRIVATE_KEY_FILE=/run/secrets/apns.p8
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase.json
APNS_PRIVATE_KEY_FILE=
FCM_SERVICE_ACCOUNT_FILE=
