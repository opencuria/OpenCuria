# Copy to .env for compose.upgrade.infra.yml / compose.upgrade.yml only.
# Use immutable backend/webapp tags or digests with scripts/deploy-production.sh.
WEBAPP_PORT=8080
DJANGO_SECRET_KEY=CHANGE_ME_long_random_secret
DJANGO_ALLOWED_HOSTS=app.example.com
DB_NAME=opencuria
DB_USER=opencuria
DB_PASSWORD=CHANGE_ME_database_password
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_fernet_key
MCP_OAUTH_CALLBACK_URL=https://app.example.com/api/v1/mcp-oauth/callback/
MCP_OAUTH_FRONTEND_RETURN_URL=https://app.example.com/?settings=credentials
CSRF_TRUSTED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
SIO_CORS_ALLOWED_ORIGINS=https://app.example.com
OPENCURIA_GATEWAY_WORKER_VERSIONS=1.2.3
OPENCURIA_DEPLOYMENT_VERSION=1.2.3
OPENCURIA_PROTOCOL_MIN=1
OPENCURIA_PROTOCOL_MAX=1
OPENCURIA_DATABASE_SCHEMA=1
OPENCURIA_DATABASE_SCHEMA_MIN=1
OPENCURIA_DATABASE_SCHEMA_MAX=1
# Set only if Compose container names differ from defaults:
# OPENCURIA_DB_HOST=opencuria-infra-db-1
# OPENCURIA_REDIS_URL=redis://opencuria-infra-redis-1:6379/0
