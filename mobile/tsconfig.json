{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "types": ["react", "react-native", "jest"]
  },
  "include": [
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": [
    "src/platform/test-mocks",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/platform/test-vite.config.ts"
  ]
}
