{
  "name": "@opencuria/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "prebuild": "APP_VARIANT=development expo prebuild",
    "type-check": "tsc --noEmit",
    "test": "npm run test:logic && npm run test:ui",
    "test:logic": "vitest run --config vitest.config.ts",
    "test:ui": "jest --runInBand",
    "export": "expo export --platform android --platform ios",
    "prebuild:production": "APP_VARIANT=production expo prebuild --clean"
  },
  "dependencies": {
    "@expo/ui": "~57.0.26",
    "@legendapp/list": "3.7.0",
    "@opencuria/chat-core": "0.0.0",
    "@opencuria/client": "0.0.0",
    "@react-native-menu/menu": "^2.0.0",
    "expo": "~57.0.30",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.20",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-widgets": "~57.0.26",
    "lucide-react-native": "^1.58.0",
    "marked": "17.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-enriched-markdown": "1.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.22.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "remend": "1.3.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
