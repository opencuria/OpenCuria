<?xml version="1.0" encoding="utf-8"?>
<!-- No apps to show: none installed yet, or signed out. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/opencuria_apps_widget_background"
  android:clipToOutline="true"
  android:gravity="center"
  android:orientation="vertical"
  android:padding="16dp">

  <ImageView
    android:layout_width="28dp"
    android:layout_height="28dp"
    android:importantForAccessibility="no"
    android:src="@drawable/opencuria_apps_widget_symbol"
    android:tint="@color/opencuria_apps_widget_secondary" />

  <TextView
    android:id="@+id/opencuria_apps_widget_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:fontFamily="sans-serif-medium"
    android:gravity="center"
    android:textColor="@color/opencuria_apps_widget_label"
    android:textSize="15sp" />

  <TextView
    android:id="@+id/opencuria_apps_widget_detail"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:gravity="center"
    android:textAppearance="@android:style/TextAppearance.DeviceDefault"
    android:textColor="@color/opencuria_apps_widget_secondary"
    android:textSize="13sp" />
</LinearLayout>
