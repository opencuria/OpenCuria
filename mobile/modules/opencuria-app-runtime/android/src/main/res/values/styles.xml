<resources>
  <!-- Installed apps draw behind transparent system bars (edge to edge). -->
  <style name="Theme.OpenCuria.AppRuntime" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
  </style>

  <!-- The app menu sheet: Material 3 components in OpenCuria's colors. -->
  <style name="Theme.OpenCuria.AppMenu" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="colorPrimary">@color/opencuria_app_menu_primary</item>
    <item name="colorOnPrimary">@color/opencuria_app_menu_on_primary</item>
    <item name="colorSurface">@color/opencuria_app_menu_surface</item>
    <item name="colorSurfaceContainerLow">@color/opencuria_app_menu_surface</item>
    <item name="colorOnSurface">@color/opencuria_app_menu_text</item>
    <item name="colorOnSurfaceVariant">@color/opencuria_app_menu_muted_text</item>
    <item name="colorOutline">@color/opencuria_app_menu_subtle_text</item>
    <item name="colorSurfaceContainerHighest">@color/opencuria_app_menu_border</item>
    <item name="colorSecondaryContainer">@color/opencuria_app_menu_control</item>
    <item name="colorOnSecondaryContainer">@color/opencuria_app_menu_text</item>
    <!-- Flat, neutral surfaces as elsewhere in OpenCuria: no primary-tinted elevation. -->
    <item name="elevationOverlayEnabled">false</item>
  </style>
</resources>
