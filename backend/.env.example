# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ENV=development
DJANGO_LOG_LEVEL=INFO

# Database (production only — dev uses SQLite)
# DB_NAME=opencuria
# DB_USER=opencuria
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Redis (production only — dev uses in-memory channel layer)
# REDIS_URL=redis://localhost:6379/0

# Allowed hosts (production only, comma-separated)
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional external SSO (paid feature)
SSO_ENABLED=false
SSO_PROVIDER=keycloak
SSO_KEYCLOAK_BASE_URL=
SSO_KEYCLOAK_REALM=
SSO_KEYCLOAK_CLIENT_ID=
# Optional for confidential Keycloak clients:
# SSO_KEYCLOAK_CLIENT_SECRET=
SSO_KEYCLOAK_SCOPE=openid email profile

# Optional server-wide native push; keys are read from files at backend startup.
# Leave all APNs values empty to disable iOS; leave the FCM path empty for Android.
# See docs/mobile-notifications.md for setup.
APNS_TEAM_ID=
APNS_KEY_ID=
# Absolute paths on the backend host, e.g. /etc/opencuria/secrets/apns.p8
# and /etc/opencuria/secrets/firebase.json.
APNS_PRIVATE_KEY_FILE=
FCM_SERVICE_ACCOUNT_FILE=
