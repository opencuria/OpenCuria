+// OpenCuria: pushed Live Activity updates carry end-to-end encrypted props.
+// OpenCuriaPushPayloadDecoder (OpenCuriaPushCrypto.swift, compiled into the
+// widget extension) decrypts them; without it, props pass through unchanged.
+private func decodeLiveActivityProps(_ props: String) -> String {
+  let selector = NSSelectorFromString("decodeLiveActivityProps:")
+  guard let decoder = NSClassFromString("OpenCuriaPushPayloadDecoder"),
+        let method = class_getClassMethod(decoder, selector) else {
+    return props
+  }
+  typealias Decode = @convention(c) (AnyClass, Selector, NSString) -> NSString?
+  let decode = unsafeBitCast(method_getImplementation(method), to: Decode.self)
+  return decode(decoder, selector, props as NSString).map { $0 as String } ?? props
+}
