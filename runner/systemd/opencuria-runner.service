[Unit]
Description=opencuria runner
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=simple
StateDirectory=opencuria-runner
# Workspace storage holds tenant data: everything the runner creates is private.
UMask=0077
Environment=RUNNER_STATE_DIR=/var/lib/opencuria-runner
WorkingDirectory=__RUNNER_DIR__
EnvironmentFile=__RUNNER_DIR__/.env
ExecStart=__RUNNER_DIR__/.venv/bin/python -m src
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
