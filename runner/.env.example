# Native Linux QEMU/KVM runner.
# Install with sudo ./runner/systemd/install-runner-service.sh

# API token for authenticating with the backend.
# Create it once in the backend UI/API and copy it here.
RUNNER_API_TOKEN=

# Backend URL. Use http(s)://host:port or ws(s)://host:port.
RUNNER_BACKEND_URL=http://localhost:8000

# Logging
RUNNER_LOG_LEVEL=INFO
RUNNER_LOG_FORMAT=json

# QEMU/KVM settings
# The runner downloads Ubuntu cloud images into RUNNER_QEMU_IMAGE_CACHE_DIR
# the first time a QEMU image build uses an ubuntu:<version> base distro.
RUNNER_QEMU_IMAGE_CACHE_DIR=/var/lib/opencuria/images
RUNNER_QEMU_DISK_DIR=/var/lib/opencuria/disks
RUNNER_QEMU_SNAPSHOT_DIR=/var/lib/opencuria/snapshots
RUNNER_QEMU_VCPUS=2
RUNNER_QEMU_MEMORY_MB=4096
RUNNER_QEMU_DISK_SIZE_GB=20
# Temporary image builders use their own resource budget.
RUNNER_QEMU_BUILD_VCPUS=1
RUNNER_QEMU_BUILD_MEMORY_MB=2048
RUNNER_QEMU_BUILD_CONCURRENCY=2
# Queue deadline for slots or temporary host RAM pressure, in seconds.
RUNNER_QEMU_BUILD_QUEUE_TIMEOUT=1800
RUNNER_QEMU_CLOUD_INIT_TIMEOUT=300
RUNNER_QEMU_SSH_USER=root
