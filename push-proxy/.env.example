# OpenCuria push proxy (compose.yml). Keep this file and ./secrets/ private.
COMPOSE_PROFILES=tls
PUSH_PROXY_TAG=latest
# The proxy's domain. Apps and servers use https://<domain> as push proxy URL.
PUSH_PROXY_DOMAIN=push.example.com
# Seals device handles. Generate with: openssl rand -base64 64 | tr -d '\n'
# Rotate by prepending a new key (comma-separated); drop the old one weeks later.
PUSH_PROXY_HANDLE_KEYS=

# iOS: the APNs auth key (.p8) of the team that signs the app. All four or none.
# APNS_TEAM_ID=ABCDE12345
# APNS_KEY_ID=FGHIJ67890
# APNS_PRIVATE_KEY_FILE=/run/secrets/apns.p8
# APNS_APP_IDS=com.opencuria.mobile,com.opencuria.mobile.dev

# Android: a service account of the app's Firebase project. Both or none.
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase.json
# FCM_APP_IDS=com.opencuria.mobile,com.opencuria.mobile.dev
